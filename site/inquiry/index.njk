---
pagination:
  data: collections.publishedProducts
  size: 1
  alias: product
permalink: "/inquiry/{{ product.data.slug }}.html"
---
<article class="product-inquiry-page">
  <header class="product-page-heading">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/products/">Products</a><span aria-hidden="true">/</span><a href="{{ product.url }}">{{ product.data.title }}</a><span aria-hidden="true">/</span><span aria-current="page">Enquiry</span></nav>
    </div>
  </header>
  <section class="product-inquiry-section">
    <div class="container product-inquiry-shell" data-product-inquiry-container>
      <div data-product-inquiry-shell>
        <span class="eyebrow">Product Enquiry</span>
        <h1>Tell Us What You Need</h1>
        <p class="product-inquiry-intro">Send your technical requirements and business email. A Realjet specialist will respond with the next steps.</p>

        <a class="inquiry-product-summary" href="{{ product.url }}">
          <img src="{{ product.data.image }}" alt="{{ product.data.imageAlt }}" width="220" height="140" decoding="async" />
          <span><small>Product</small><strong>{{ product.data.title }}</strong><em>View product details →</em></span>
        </a>

        <form name="product-inquiry" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-product-inquiry-form data-inquiry-variant="dedicated">
          <input type="hidden" name="form-name" value="product-inquiry" />
          <input type="hidden" name="product_title" value="{{ product.data.title }}" />
          <input type="hidden" name="product_slug" value="{{ product.data.slug }}" />
          <input type="hidden" name="subject" value="Product enquiry: {{ product.data.title }}" />
          <p class="honeypot"><label>Do not fill this field <input name="bot-field" /></label></p>
          <fieldset>
            <label class="inquiry-field">
              <span>Message <b aria-hidden="true">*</b></span>
              <textarea name="message" rows="10" maxlength="4000" placeholder="Please include the component type, drawings or dimensions, target output, project location, schedule and any other known requirements." required data-inquiry-message></textarea>
              <small><span data-inquiry-count>0</span>/4000</small>
            </label>
            <label class="inquiry-field inquiry-email-field">
              <span>Business Email <b aria-hidden="true">*</b></span>
              <input name="email" type="email" autocomplete="email" placeholder="name@company.com" required />
            </label>
            <p class="inquiry-privacy">By sending this enquiry, you acknowledge that Realjet will use the information to respond to your request. See our <a href="/marketing/privacy/en/" target="_blank" rel="noopener noreferrer">Privacy Policy</a>.</p>
            <p class="form-error" role="alert" data-product-inquiry-error hidden>We could not send your enquiry. Please check your connection and try again.</p>
            <button class="button button-dark product-inquiry-submit" type="submit" data-product-inquiry-submit>Send Enquiry <span aria-hidden="true">→</span></button>
          </fieldset>
        </form>
      </div>

      <section class="product-inquiry-success" role="status" data-product-inquiry-success hidden tabindex="-1">
        <span class="success-mark" aria-hidden="true">✓</span>
        <h1>Enquiry Sent Successfully</h1>
        <p>Thank you. A Realjet specialist will review your requirements and contact you at the email address provided.</p>
        <div class="inquiry-success-actions"><a class="button button-dark" href="{{ product.url }}">Return to Product</a><a class="text-link" href="/products/">View More Products <span aria-hidden="true">→</span></a></div>
      </section>
    </div>
  </section>
</article>
