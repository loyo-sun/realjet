<body class="pc-plant" data-page-type="building_precast_plant">
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="pc-header">
  <div class="pc-container pc-header-inner">
    <a class="pc-brand" href="/" aria-label="REALJET home"><img src="/images/realjet-logo.webp" width="1351" height="184" alt="REALJET" /></a>
    <button type="button" class="pc-menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="pc-navigation" data-pc-menu><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg></button>
    <nav id="pc-navigation" class="pc-navigation" aria-label="Production line navigation">
      <a href="#production-lines">Production Lines</a><a href="#process">Process</a><a href="#equipment">Equipment</a><a href="#projects">Case Studies</a><a href="#faqs">FAQs</a>
      <a class="pc-button pc-button-primary" href="#plant-proposal" data-pc-cta="nav_proposal">Get a Plant Proposal <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>
<main id="main-content">
  <section class="pc-hero" aria-labelledby="pc-title">
    <img class="pc-hero-background" src="/images/building-precast/hero.webp" alt="" aria-hidden="true" width="427" height="359" fetchpriority="high" />
    <div class="pc-hero-overlay" aria-hidden="true"></div>
    <div class="pc-container">
      <div class="pc-hero-grid">
        <div class="pc-hero-copy">
          <div class="pc-eyebrow">Engineered around your product</div>
          <h1 id="pc-title">Turnkey Precast Concrete Plants for <span>Walls and Floor Slabs</span></h1>
          <p>Plan your factory around your products, output targets and site conditions. REALJET brings together line layout, equipment and commissioning support.</p>
          <div class="pc-actions"><a class="pc-button pc-button-primary" href="#plant-proposal" data-pc-cta="hero_proposal">Get a Plant Proposal <span aria-hidden="true">↗</span></a><a class="pc-button pc-button-whatsapp" href="https://wa.me/8619310090600?text=Hello%2C%20I%20would%20like%20to%20discuss%20a%20precast%20concrete%20plant%20for%20walls%20and%20floor%20slabs." target="_blank" rel="noopener noreferrer" data-cta-id="plant_hero_whatsapp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.5L3 20.5l1.3-4.7a8.5 8.5 0 1 1 16.2-4.2z"/><path d="M8 8c0 4 4 8 8 8l1-2-3-1-1 1-3-3 1-1-1-3-2 1z"/></svg> WhatsApp</a><a class="pc-text-link" href="#production-lines" data-pc-cta="hero_compare">Compare Production Lines <span aria-hidden="true">↓</span></a></div>
        </div>
      </div>
      <div class="pc-support"><div><strong>Project-specific layouts</strong></div><div><strong>Carousel and long-line options</strong></div><div><strong>Integrated production equipment</strong></div></div>
    </div>
  </section>

  <section class="pc-section" id="production-lines">
    <div class="pc-container">
      <div class="pc-section-head"><div class="pc-eyebrow">Production lines</div><h2>Choose a Line for<br> Your Product Mix</h2><p>Start with the elements you plan to make. We match the line concept to your product mix, production targets and site conditions.</p></div>
      {% set products = [
        {name:'Solid wall panels',path:'M22 12 85 28 85 83 22 67Z M22 12 35 6 98 22 85 28 M85 83 98 77 98 22'},
        {name:'Insulated sandwich panels',path:'M15 18 69 30 69 84 15 72Z M30 10 84 22 84 76 M45 3 99 15 99 69'},
        {name:'Lattice girder slabs',path:'M8 70 70 88 108 59 47 43Z M20 63 29 37 38 68 M38 68 47 42 56 73 M56 73 65 47 74 79 M74 79 83 53 92 66 M29 37 83 53'},
        {name:'Special precast elements',path:'M12 76 32 76 32 58 51 58 51 40 71 40 71 22 90 22 90 76 M12 76 29 86 108 86 108 32 90 22'}
      ] %}
      <div class="pc-products">{% for product in products %}<div><svg viewBox="0 0 120 100" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="{{ product.path }}" /></svg><span>{{ product.name }}</span></div>{% endfor %}</div>
      <div class="pc-lines-grid">
        {% for line in buildingPrecast.lines %}
        <article class="pc-line-card">
          <div class="pc-line-image pc-image-fit"><img src="/images/building-precast/{{ line[1] }}.webp" alt="{{ line[0] }} reference configuration for building precast concrete elements" width="1200" height="675" loading="lazy" decoding="async" /></div>
          <div class="pc-line-body"><div class="pc-eyebrow">{{ line[2] }}</div><h3>{{ line[0] }}</h3><p class="pc-line-products">{{ line[3] }}</p><p>{{ line[4] }}</p><dl><div><dt>Automation scope</dt><dd>{{ line[5] }}</dd></div><div><dt>Inputs to review</dt><dd>{{ line[6] }}</dd></div></dl><a class="pc-button pc-button-outline" href="#plant-proposal" data-pc-line="{{ line[0] }}" data-pc-cta="line_{{ loop.index }}">Discuss This Configuration <span aria-hidden="true">↗</span></a></div>
        </article>
        {% endfor %}
      </div>
      <p class="pc-note">Configuration, capacity and delivery scope are defined for each project after technical review. Prestressing compatibility is confirmed for the selected product.</p>
    </div>
  </section>

  <section class="pc-section pc-section-soft" id="process">
    <div class="pc-container"><div class="pc-section-head"><div class="pc-eyebrow">Production process</div><h2>From Table Preparation<br> to Finished Elements</h2><p>One connected flow, from the production plan to the dispatch yard. The final sequence follows your wall and slab designs.</p></div>
      <ol class="pc-process" role="list">{% for step in buildingPrecast.process %}<li><h3>{{ step[1] }}</h3><p>{{ step[2] }}</p><span class="pc-step-arrow" aria-hidden="true">↗</span></li>{% endfor %}</ol>
      <div class="pc-process-notes"><p><strong>Sandwich walls</strong> add insulation placement and a second concrete layer to the casting sequence.</p><p><strong>Prestressed slabs</strong> require separate stressing, anchorage and release steps. This process concept does not replace final engineering design.</p></div>
    </div>
  </section>

  <section class="pc-section" id="equipment">
    <div class="pc-container"><div class="pc-section-head pc-head-wide"><div><div class="pc-eyebrow">Equipment integration</div><h2>Coordinate Equipment<br> Around the Whole Line</h2></div><p>Equipment for carousel, prestressed slab and long-line production. Final models and specifications are confirmed for your plant configuration.</p></div>
      <div class="pc-equipment-grid">{% for item in buildingPrecast.equipment %}<article class="pc-equipment-card"><a href="#plant-proposal" data-pc-equipment="{{ item[0] }}" data-pc-cta="equipment_image_{{ item[1] }}" aria-label="Enquire about {{ item[0] }}" class="pc-equipment-image"><img src="/images/building-precast/{{ item[1] }}.webp" alt="{{ item[0] }} reference equipment for a wall and slab precast plant" width="1200" height="750" loading="lazy" decoding="async" /></a><div><h3><a href="#plant-proposal" data-pc-equipment="{{ item[0] }}" data-pc-cta="equipment_{{ item[1] }}">{{ item[0] }} <span aria-hidden="true">↗</span></a></h3><p>{{ item[2] }}</p><p class="pc-parameters">{{ item[3] }}</p></div></article>{% endfor %}</div>
      <div class="pc-single"><p><strong>Need a single machine?</strong><span>Tell us about your existing equipment and interfaces.</span></p><a class="pc-button pc-button-dark" href="#plant-proposal" data-pc-need="Single equipment" data-pc-cta="single_equipment">Discuss Single Equipment <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>

  <section class="pc-section pc-section-soft" id="projects">
    <div class="pc-container"><div class="pc-section-head"><div class="pc-eyebrow">Case studies</div><h2>Precast Plant Projects</h2><p>Explore 20 project sites across China.</p><p class="pc-case-privacy">To protect customer privacy, all customer and company names have been omitted.</p></div>
      <div class="pc-case-carousel" data-pc-cases role="region" aria-roledescription="carousel" aria-label="Precast plant case studies">
        <div class="pc-case-slider"><button class="pc-case-arrow" type="button" data-pc-case-prev aria-label="Previous projects" aria-controls="pc-case-track" hidden>←</button>
        <ul class="pc-case-track" id="pc-case-track" data-pc-case-track tabindex="0" aria-label="Project photos — scroll to explore all 20 projects" role="list">{% for project in buildingPrecast.cases %}<li class="pc-case-card"><figure><img src="/images/building-precast/{{ project.image }}.webp" alt="{{ project.alt }}" width="{{ project.width }}" height="{{ project.height }}" loading="lazy" decoding="async" /><figcaption><h3><a href="#plant-proposal" data-pc-case="a precast plant similar to the project in {{ project.name }}" data-pc-cta="case_{{ project.image }}">{{ project.name }} <span aria-hidden="true">↗</span></a></h3><span class="pc-case-location">{{ project.location }}</span></figcaption></figure></li>{% endfor %}</ul>
        <button class="pc-case-arrow" type="button" data-pc-case-next aria-label="Next projects" aria-controls="pc-case-track" hidden>→</button></div>
        <div class="pc-case-footer"><span class="pc-case-progress" data-pc-case-progress>20 projects</span><div class="pc-case-controls" data-pc-case-controls hidden><button type="button" data-pc-case-pause aria-label="Pause automatic project slideshow">Pause</button></div><a class="pc-button pc-button-primary" href="#plant-proposal" data-pc-case="a precast plant similar to the featured projects" data-pc-cta="case_studies_proposal">Discuss a Similar Project <span aria-hidden="true">↗</span></a></div>
      </div>
    </div>
  </section>

  <section class="pc-section" id="delivery">
    <div class="pc-container"><div class="pc-section-head"><div class="pc-eyebrow">Scope & delivery</div><h2>Know What Goes Into<br> Your Plant Proposal</h2><p>A useful starting point for technical and commercial discussion, with clear responsibilities before implementation.</p></div>
      <div class="pc-scope-grid"><div class="pc-deliverables"><div class="pc-eyebrow">Your proposal review</div><h3>From your requirements<br> to a line concept.</h3><ol><li>Product and capacity review</li><li>Proposed line concept</li><li>Key equipment scope</li><li>Utility and site interface checklist</li><li>Implementation assumptions</li></ol></div><div class="pc-responsibilities"><article><div><h3>Included in agreed package</h3><p>Line engineering, selected equipment and the installation, commissioning and training services defined in your quotation.</p></div></article><article><div><h3>Optional</h3><p>Reinforcement preparation, spare parts and staged upgrades.</p></div></article><article><div><h3>Customer / local contractor</h3><p>Civil works, approvals, raw materials and local utilities. Logistics, taxes and engineer travel are assigned explicitly in the quotation.</p></div></article></div></div>
      {% set stages = ['Requirements','Line concept','Technical & commercial confirmation','Design & manufacture','Installation & commissioning','Trial production & training'] %}<ol class="pc-delivery-stages" role="list">{% for stage in stages %}<li><strong>{{ stage }}</strong></li>{% endfor %}</ol>
    </div>
  </section>

  <section class="pc-section pc-enquiry" id="plant-proposal">
    <div class="pc-container pc-enquiry-grid"><div class="pc-enquiry-copy"><div class="pc-eyebrow">Start your project</div><h2>Start Your Project</h2><p>Tell us about your plant, production line or equipment needs. No drawings required to get started.</p><div class="pc-direct"><a href="mailto:sales@realjetech.com" data-cta-id="plant_email">sales@realjetech.com <span aria-hidden="true">↗</span></a><a class="pc-button pc-button-whatsapp" href="https://wa.me/8619310090600?text=Hello%2C%20I%20would%20like%20to%20discuss%20a%20precast%20concrete%20plant%20for%20walls%20and%20floor%20slabs." target="_blank" rel="noopener noreferrer" data-cta-id="plant_whatsapp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.5L3 20.5l1.3-4.7a8.5 8.5 0 1 1 16.2-4.2z"/><path d="M8 8c0 4 4 8 8 8l1-2-3-1-1 1-3-3 1-1-1-3-2 1z"/></svg> Chat on WhatsApp</a></div></div>
      <div class="pc-form-card">
        <form name="universal-enquiry" method="POST" action="/solutions/precast-concrete-plant/" data-netlify="true" netlify-honeypot="bot-field" data-pc-form>
          <input type="hidden" name="form-name" value="universal-enquiry" /><input type="hidden" name="page_type" value="building_precast_plant" /><input type="hidden" name="locale" value="en" /><input type="hidden" name="subject" value="Building precast plant proposal enquiry" /><input type="hidden" name="keyword" value="Precast concrete plant for walls and floor slabs" /><input type="hidden" name="submission_id" value="" /><input type="hidden" name="line_interest" value="" /><input type="hidden" name="project_need" value="" />
          <p class="honeypot" hidden><label>Do not fill this field <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
          <fieldset><legend class="pc-sr-only">Your contact details and message</legend>
            <div class="pc-form-intro"><h3>Tell Us What You Need</h3></div>
            <label for="pc-name">Name<input id="pc-name" name="name" autocomplete="name" maxlength="120" required placeholder="Your name" /></label><label for="pc-country">Country<input id="pc-country" name="country" autocomplete="country-name" maxlength="100" required placeholder="Your country" /></label>
            <label for="pc-email">Email<input id="pc-email" type="email" name="email" autocomplete="email" maxlength="254" required placeholder="you@company.com" /></label>
            <label for="pc-message">Message<textarea id="pc-message" name="message" rows="3" maxlength="4000" required placeholder="Tell us about your products, output targets or project requirements."></textarea></label>
            <p class="pc-privacy-notice">REALJET uses this information to respond to your enquiry, as described in our <a href="/marketing/privacy/en/" target="_blank" rel="noopener noreferrer">Privacy Policy</a>.</p>
            <p class="pc-form-error" role="alert" data-pc-error hidden>We could not confirm receipt. Your information is still here. Please try again or email <a href="mailto:sales@realjetech.com">sales@realjetech.com</a>.</p>
            <button class="pc-button pc-button-primary pc-submit" type="submit" data-pc-submit>Send Enquiry <span aria-hidden="true">↗</span></button>
          </fieldset>
        </form>
        <section class="pc-form-success" data-pc-success hidden tabindex="-1" role="status"><span class="pc-success-check" aria-hidden="true">✓</span><h3>Enquiry received</h3><p>Thank you. We will review your requirements and contact you to clarify the next steps.</p><p>To add drawings or project details, reply when our team contacts you or email <a href="mailto:sales@realjetech.com">sales@realjetech.com</a>.</p><a class="pc-button pc-button-dark" href="#production-lines">Back to Production Lines <span aria-hidden="true">↑</span></a></section>
      </div>
    </div>
  </section>

  <section class="pc-section" id="faqs"><div class="pc-container pc-faq-grid"><div class="pc-section-head"><div class="pc-eyebrow">FAQs</div><h2>Before You Plan<br> Your Plant</h2><p>Practical answers for your engineering and procurement team.</p></div><div class="pc-faq-list">{% for faq in buildingPrecast.faq %}<details{% if loop.first %} open{% endif %}><summary>{{ faq[0] }}<span aria-hidden="true">+</span></summary><p>{{ faq[1] }}</p></details>{% endfor %}</div></div></section>
</main>
<footer class="pc-footer"><div class="pc-container"><div class="pc-footer-top"><a class="pc-brand" href="/"><img src="/images/realjet-logo.webp" width="1351" height="184" alt="REALJET home" /></a><p>Precast concrete production.<br> Engineered around your project.</p></div><div class="pc-footer-bottom"><span>© 2026 {{ site.legalName }}</span><div><a href="/marketing/privacy/en/">Privacy Policy</a><button type="button" data-open-analytics>Cookie Preferences</button><a href="mailto:sales@realjetech.com">sales@realjetech.com</a></div></div></div></footer>
<nav class="pc-mobile-actions" aria-label="Contact REALJET"><a class="pc-button pc-button-primary" href="#plant-proposal" data-pc-cta="mobile_proposal">Get Proposal <span aria-hidden="true">↗</span></a><a class="pc-button pc-button-outline" href="https://wa.me/8619310090600?text=Hello%2C%20I%20would%20like%20to%20discuss%20a%20precast%20concrete%20plant%20for%20walls%20and%20floor%20slabs." target="_blank" rel="noopener noreferrer" data-cta-id="plant_mobile_whatsapp">WhatsApp ↗</a></nav>
<div class="pc-sr-only" role="status" aria-live="polite" data-pc-email-announcement></div>
<aside class="pc-email-panel" data-pc-email-panel hidden role="dialog" aria-modal="false" aria-labelledby="pc-email-title" aria-describedby="pc-email-description">
  <button class="pc-email-close" type="button" data-pc-email-close aria-label="Close email offer">×</button>
  <div class="pc-eyebrow">Complete plant solution</div><h2 id="pc-email-title">Get the Complete Solution</h2><p id="pc-email-description">Leave your email to receive the complete precast plant solution.</p>
  <form name="universal-enquiry" method="POST" action="/solutions/precast-concrete-plant/" data-netlify="true" netlify-honeypot="bot-field" data-pc-email-form>
    <input type="hidden" name="form-name" value="universal-enquiry" /><input type="hidden" name="name" value="Name" /><input type="hidden" name="message" value="客户通过滚动留下了邮箱信息。" /><input type="hidden" name="subject" value="Precast plant complete solution request (scroll email)" /><input type="hidden" name="keyword" value="Precast concrete plant complete solution" /><input type="hidden" name="page_type" value="building_precast_plant" /><input type="hidden" name="locale" value="en" /><input type="hidden" name="project_need" value="Complete solution" /><input type="hidden" name="enquiry_source" value="scroll_email" /><input type="hidden" name="submission_id" value="" />
    <p hidden><label>Do not fill this field <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
    <fieldset><legend class="pc-sr-only">Email for the complete solution</legend><label for="pc-offer-email">Email<input id="pc-offer-email" type="email" name="email" autocomplete="email" inputmode="email" maxlength="254" required placeholder="you@company.com" aria-describedby="pc-email-notice pc-email-error" /></label><p class="pc-field-error" id="pc-email-error" data-pc-email-error role="alert" hidden></p><button class="pc-button pc-button-primary" type="submit">Leave Your Email for the Complete Solution <span aria-hidden="true">↗</span></button><p class="pc-privacy-notice" id="pc-email-notice">We use your email to respond to this request. <a href="/marketing/privacy/en/" target="_blank" rel="noopener noreferrer">Privacy Policy</a></p></fieldset>
  </form>
  <div class="pc-email-success" data-pc-email-success hidden role="status" tabindex="-1"><strong>Email received</strong><p>Thank you. Our team will follow up with the complete solution.</p></div>
</aside>
<script src="/assets/site/site.js" defer></script><script src="/assets/site/building-precast.js" defer></script><script src="/assets/site/building-precast-cases.js" defer></script><script src="/assets/site/building-precast-email.js" defer></script>
</body></html>
