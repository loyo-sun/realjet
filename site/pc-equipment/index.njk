---
pagination:
  data: pcEquipment
  size: 1
  alias: equipment
permalink: "{{ equipment.url }}index.html"
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="{{ equipment.description | escape }}" />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#08253f" />
  <title>{{ equipment.title | escape }}</title>
  <link rel="canonical" href="{{ equipment.canonical | escape }}" />
  <link rel="icon" type="image/svg+xml" href="/icons/realjet-site-icon.svg" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="{{ equipment.title | escape }}" />
  <meta property="og:description" content="{{ equipment.description | escape }}" />
  <meta property="og:url" content="{{ equipment.canonical | escape }}" />
  <meta property="og:image" content="https://realjetech.com{{ equipment.image }}" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preload" as="image" href="{{ equipment.image }}" fetchpriority="high" />
  <link rel="stylesheet" href="/assets/site/site.css" />
  <link rel="stylesheet" href="/assets/site/building-precast.css" />
  <script>window.dataLayer=window.dataLayer||[];window.gtag=window.gtag||function(){window.dataLayer.push(arguments)};window.gtag('consent','default',{analytics_storage:'denied',ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',wait_for_update:500});</script>
  <link rel="stylesheet" href="/assets/site/pc-equipment.css" />
  <script type="application/ld+json">{{ equipment.schema | json | safe }}</script>
</head>
<body class="pc-plant pc-product" data-page-type="precast_equipment" data-equipment-id="{{ equipment.slug }}">
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="pc-header">
  <div class="pc-container pc-header-inner">
    <a class="pc-brand" href="/" aria-label="REALJET home"><img src="/images/realjet-logo.webp" width="1351" height="184" alt="REALJET" /></a>
    <button type="button" class="pc-menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="pc-navigation" data-pc-menu><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg></button>
    <nav id="pc-navigation" class="pc-navigation" aria-label="Production line navigation">
      <a href="/solutions/precast-concrete-plant/">Plant Solutions</a><a href="/solutions/precast-concrete-plant/#equipment">All Equipment</a><a href="#specifications">Specifications</a><a href="#faqs">FAQs</a>
      <a class="pc-button pc-button-primary" href="#plant-proposal" data-pc-cta="equipment_nav">Request Equipment Details <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>
<main id="main-content">
  <div class="pc-container"><nav class="pce-breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/solutions/precast-concrete-plant/">Precast Concrete Plants</a><span aria-hidden="true">/</span><span aria-current="page">{{ equipment.name | escape }}</span></nav></div>
  <section class="pce-hero" aria-labelledby="equipment-title">
    <div class="pc-container pce-hero-grid">
      <div class="pce-hero-copy"><div class="pc-eyebrow">Precast production equipment</div><h1 id="equipment-title">{{ equipment.h1 | escape }}</h1><p>{{ equipment.intro | escape }}</p>
      <div class="pc-actions"><a class="pc-button pc-button-primary" href="#plant-proposal" data-pc-cta="equipment_hero">Request Equipment Details <span aria-hidden="true">↗</span></a><a class="pc-text-link" href="#specifications">View Specifications <span aria-hidden="true">↓</span></a></div></div>
      <figure class="pce-product-figure"><div class="pce-product-image"><img src="{{ equipment.image }}" alt="{{ equipment.alt | escape }}" width="1200" height="750" fetchpriority="high" decoding="async" /></div><figcaption>{{ equipment.caption | escape }}</figcaption></figure>
    </div>
  </section>
  <div class="pc-container pce-detail-grid">
    <div class="pce-body">
      {% for section in equipment.sections %}
      <section class="pce-copy" id="{% if loop.first %}application{% elif loop.index == 2 %}features{% elif loop.index == 3 %}operation{% else %}selection{% endif %}"><div class="pc-eyebrow">{% if loop.first %}Application{% elif loop.index == 2 %}Equipment features{% elif loop.index == 3 %}Working sequence{% else %}Equipment selection{% endif %}</div><h2>{{ section.heading | escape }}</h2>{{ section.text | pcEquipmentMarkdown | safe }}</section>
      {% if loop.index == 3 %}
      <section class="pce-copy" id="specifications"><div class="pc-eyebrow">Technical reference</div><h2>Reference Specifications</h2><table class="pce-specs"><caption class="pc-sr-only">{{ equipment.name | escape }} reference specifications</caption><thead><tr><th scope="col">Item</th><th scope="col">Reference specification</th></tr></thead><tbody>{% for spec in equipment.specs %}<tr><th scope="row">{{ spec.name | escape }}</th><td>{{ spec.value | escape }}</td></tr>{% endfor %}</tbody></table><p class="pce-reference-note">These figures describe the reference configuration. Final dimensions, equipment scope and operating conditions are confirmed in the project specification.</p></section>
      {% endif %}
      {% endfor %}
    </div>
    <aside class="pce-sidebar"><nav aria-label="On this page"><strong>On this page</strong><a href="#application">Application</a><a href="#features">Equipment Features</a><a href="#operation">Working Sequence</a><a href="#specifications">Specifications</a><a href="#selection">Equipment Selection</a><a href="#faqs">FAQs</a><a href="#plant-proposal">Request Equipment Details ↗</a></nav><a class="pce-back" href="/solutions/precast-concrete-plant/#equipment">← View All PC Equipment</a></aside>
  </div>
  <section class="pc-section pc-section-soft" id="faqs"><div class="pc-container pc-faq-grid"><div class="pc-section-head"><div class="pc-eyebrow">Equipment questions</div><h2>Frequently Asked Questions</h2></div><div class="pc-faq-list">{% for faq in equipment.faqs %}<details{% if loop.first %} open{% endif %}><summary>{{ faq.question | escape }}<span aria-hidden="true">+</span></summary><p>{{ faq.answer | escape }}</p></details>{% endfor %}</div></div></section>
  <section class="pc-section" id="related-equipment"><div class="pc-container"><div class="pc-section-head"><div class="pc-eyebrow">Connected production</div><h2>Related Equipment and Plant Planning</h2></div><div class="pce-related-grid">{% for related in equipment.related %}<article class="pce-related-card"><h3><a href="{{ related.url }}">{{ related.name | escape }} <span aria-hidden="true">↗</span></a></h3><p>{{ related.description | escape }}</p></article>{% endfor %}</div></div></section>
  <section class="pc-section pc-enquiry" id="plant-proposal">
    <div class="pc-container pc-enquiry-grid"><div class="pc-enquiry-copy"><div class="pc-eyebrow">Start your project</div><h2>{{ equipment.cta.heading | escape }}</h2><p>{{ equipment.cta.text | escape }}</p><div class="pc-direct"><a href="mailto:sales@realjetech.com" data-cta-id="plant_email">sales@realjetech.com <span aria-hidden="true">↗</span></a><a class="pc-button pc-button-whatsapp" href="https://wa.me/8619310090600?text={{ ('Hello, I would like to discuss the ' + equipment.name + ' for my precast plant. ' + equipment.canonical) | urlencode }}" target="_blank" rel="noopener noreferrer" data-cta-id="plant_whatsapp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.5L3 20.5l1.3-4.7a8.5 8.5 0 1 1 16.2-4.2z"/><path d="M8 8c0 4 4 8 8 8l1-2-3-1-1 1-3-3 1-1-1-3-2 1z"/></svg> Chat on WhatsApp</a></div></div>
      <div class="pc-form-card">
        <form name="universal-enquiry" method="POST" action="{{ equipment.url }}" data-netlify="true" netlify-honeypot="bot-field" data-pc-form>
          <input type="hidden" name="form-name" value="universal-enquiry" /><input type="hidden" name="page_type" value="precast_equipment" /><input type="hidden" name="locale" value="en" /><input type="hidden" name="subject" value="Equipment enquiry: {{ equipment.name | escape }}" /><input type="hidden" name="keyword" value="{{ equipment.name | escape }}" /><input type="hidden" name="submission_id" value="" /><input type="hidden" name="equipment_id" value="{{ equipment.slug }}" /><input type="hidden" name="source_url" value="{{ equipment.canonical }}" /><input type="hidden" name="line_interest" value="" /><input type="hidden" name="project_need" value="Single equipment" />
          <p class="honeypot" hidden><label>Do not fill this field <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
          <fieldset><legend class="pc-sr-only">Your contact details and message</legend>
            <div class="pc-form-intro"><h3>Tell Us What You Need</h3></div>
            <label for="pc-name">Name<input id="pc-name" name="name" autocomplete="name" maxlength="120" required placeholder="Your name" /></label><label for="pc-country">Country<input id="pc-country" name="country" autocomplete="country-name" maxlength="100" required placeholder="Your country" /></label>
            <label for="pc-email">Email<input id="pc-email" type="email" name="email" autocomplete="email" maxlength="254" required placeholder="you@company.com" /></label>
            <label for="pc-message">Message<textarea id="pc-message" name="message" rows="3" maxlength="4000" required placeholder="Tell us about your equipment and plant requirements.">I would like to discuss the {{ equipment.name | lower | escape }} for my precast plant.</textarea></label>
            <p class="pc-privacy-notice">REALJET uses this information to respond to your enquiry, as described in our <a href="/marketing/privacy/en/" target="_blank" rel="noopener noreferrer">Privacy Policy</a>.</p>
            <p class="pc-form-error" role="alert" data-pc-error hidden>We could not confirm receipt. Your information is still here. Please try again or email <a href="mailto:sales@realjetech.com">sales@realjetech.com</a>.</p>
            <button class="pc-button pc-button-primary pc-submit" type="submit" data-pc-submit>Send Enquiry <span aria-hidden="true">↗</span></button>
          </fieldset>
        </form>
        <section class="pc-form-success" data-pc-success hidden tabindex="-1" role="status"><span class="pc-success-check" aria-hidden="true">✓</span><h3>Enquiry received</h3><p>Thank you. We will review your requirements and contact you to clarify the next steps.</p><p>To add drawings or project details, reply when our team contacts you or email <a href="mailto:sales@realjetech.com">sales@realjetech.com</a>.</p><a class="pc-button pc-button-dark" href="/solutions/precast-concrete-plant/#equipment">Back to Equipment <span aria-hidden="true">↑</span></a></section>
      </div>
    </div>
  </section>

</main>
<footer class="pc-footer"><div class="pc-container"><div class="pc-footer-top"><a class="pc-brand" href="/"><img src="/images/realjet-logo.webp" width="1351" height="184" alt="REALJET home" /></a><p>Precast concrete production.<br> Engineered around your project.</p></div><div class="pc-footer-bottom"><span>© 2026 {{ site.legalName }}</span><div><a href="/marketing/privacy/en/">Privacy Policy</a><button type="button" data-open-analytics>Cookie Preferences</button><a href="mailto:sales@realjetech.com">sales@realjetech.com</a></div></div></div></footer>
<nav class="pc-mobile-actions" aria-label="Contact REALJET"><a class="pc-button pc-button-primary" href="#plant-proposal" data-pc-cta="equipment_mobile">Enquire <span aria-hidden="true">↗</span></a><a class="pc-button pc-button-outline" href="https://wa.me/8619310090600?text={{ ('Hello, I would like to discuss the ' + equipment.name + ' for my precast plant. ' + equipment.canonical) | urlencode }}" target="_blank" rel="noopener noreferrer" data-cta-id="plant_mobile_whatsapp">WhatsApp ↗</a></nav>
<script src="/assets/site/site.js" defer></script><script src="/assets/site/building-precast.js" defer></script>
</body></html>
