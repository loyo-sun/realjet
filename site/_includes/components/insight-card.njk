<article class="insight-card">
  <a class="insight-image" href="{{ post.url }}" data-insight-card data-article-slug="{{ post.data.slug }}" data-card-position="{{ loop.index }}" tabindex="-1" aria-hidden="true">
    <img src="{{ post.data.image }}" alt="{{ post.data.imageAlt }}" width="640" height="360" loading="lazy" decoding="async" />
  </a>
  <div class="insight-card-body">
    <time datetime="{{ post.data.date | isoDate }}">{{ post.data.date | readableDate }}</time>
    <h3><a href="{{ post.url }}" data-insight-card data-article-slug="{{ post.data.slug }}" data-card-position="{{ loop.index }}">{{ post.data.title }}</a></h3>
    <p>{{ post.data.description }}</p>
    <a class="text-link" href="{{ post.url }}" data-insight-card data-article-slug="{{ post.data.slug }}" data-card-position="{{ loop.index }}">Read Article <span aria-hidden="true">→</span></a>
  </div>
</article>
