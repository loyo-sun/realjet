{% if relatedProducts and relatedProducts.length %}
<aside class="product-aside" aria-labelledby="related-products-title">
  <span class="eyebrow">Spun Pile Production</span>
  <h2 id="related-products-title">Related Equipment</h2>
  <nav class="latest-product-list" aria-label="Related spun pile equipment">
    {% for item in collections.publishedProducts | relatedEquipment(relatedProducts) %}
    <a href="{{ item.url }}">
      <img src="{{ item.data.image }}" alt="" width="120" height="75" loading="lazy" decoding="async" />
      <span>{{ item.data.title }}</span>
    </a>
    {% endfor %}
  </nav>
</aside>
{% else %}
<aside class="product-aside" aria-labelledby="latest-products-title">
  <span class="eyebrow">Recently Added</span>
  <h2 id="latest-products-title">Latest Products</h2>
  <nav class="latest-product-list" aria-label="Latest products">
    {% for item in collections.latestProducts | limit(6) %}
      {% if item.data.slug != slug %}
      <a href="{{ item.url }}">
        <img src="{{ item.data.image }}" alt="" width="120" height="76" loading="lazy" decoding="async" />
        <span>{{ item.data.title }}</span>
      </a>
      {% endif %}
    {% endfor %}
  </nav>
</aside>
{% endif %}
