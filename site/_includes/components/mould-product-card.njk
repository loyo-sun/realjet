<article class="mould-product-card">
  <a class="mould-product-image" href="/precast-concrete-molds/{{ mouldProduct.slug }}/" tabindex="-1" aria-hidden="true">
    <img src="{{ precastMouldCatalog.placeholderImage }}" alt="{{ mouldProduct.imageAlt }}" width="640" height="360" loading="lazy" decoding="async" />
  </a>
  <div class="mould-product-card-body">
    <span>{{ mouldProduct.order | string }}</span>
    <h3><a href="/precast-concrete-molds/{{ mouldProduct.slug }}/">{{ mouldProduct.title }}</a></h3>
    <p>{{ mouldProduct.description }}</p>
    <a class="text-link" href="/precast-concrete-molds/{{ mouldProduct.slug }}/" data-mould-product="{{ mouldProduct.slug }}">View product <span aria-hidden="true">→</span></a>
  </div>
</article>
