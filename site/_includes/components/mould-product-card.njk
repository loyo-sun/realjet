<article class="mould-product-card">
  <a class="mould-product-image" href="{{ mouldProduct.url }}" tabindex="-1" aria-hidden="true">
    <img src="{{ mouldProduct.data.image }}" alt="{{ mouldProduct.data.imageAlt }}" width="640" height="360" loading="lazy" decoding="async" />
  </a>
  <div class="mould-product-card-body">
    <h3><a href="{{ mouldProduct.url }}" data-mould-product="{{ mouldProduct.data.slug }}">{{ mouldProduct.data.title }}</a></h3>
    <p>{{ mouldProduct.data.description }}</p>
    <div class="mould-product-actions">
      <button class="button button-primary" type="button" data-universal-enquiry data-enquiry-keyword="Product enquiry: {{ mouldProduct.data.title }}">Enquiry</button>
      <a class="button mould-details-button" href="{{ mouldProduct.url }}" data-mould-product="{{ mouldProduct.data.slug }}">View</a>
    </div>
  </div>
</article>
