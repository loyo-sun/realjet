<article class="product-card">
  <a class="product-image" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    <img src="{{ product.data.imageSmall or product.data.image }}"{% if product.data.imageSmall %} srcset="{{ product.data.imageSmall }} 640w, {{ product.data.image }} 1200w" sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"{% endif %} alt="{{ product.data.imageAlt }}" width="640" height="360" loading="lazy" decoding="async" />
  </a>
  <div class="product-card-body">
    {% if product.data.aiEnergyProduct %}<span class="eyebrow">{{ product.data.sheetMetalFamily }}</span>{% endif %}
    <h3><a href="{{ product.url }}">{{ product.data.title }}</a></h3>
    <p>{{ product.data.listingDescription or product.data.description }}</p>
    <a class="button button-dark product-action" href="{{ product.url }}">View Details <span aria-hidden="true">→</span></a>
  </div>
</article>
