<div class="industry-ui industry-ui--{{ industryLanding }}">
<header class="industry-hero">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/products/">Products</a><span>/</span><span aria-current="page">{% if industryLanding == 'ai' %}AI equipment components{% else %}Storage, charging &amp; solar components{% endif %}</span></nav>
    <div class="industry-hero-grid">
      <div class="industry-hero-copy"><span class="eyebrow">{{ industry.eyebrow }}</span><h1>{{ title }}</h1><p>{{ industry.intro }}</p><div class="industry-hero-actions"><a href="#components" class="button button-dark">Explore Components <span aria-hidden="true">↓</span></a><button class="button industry-outline-button" type="button" data-universal-enquiry data-enquiry-keyword="{{ title }} drawing review">Enquiry <span aria-hidden="true">↗</span></button></div><div class="industry-hero-facts"><span>Made to <strong>your drawings</strong></span></div></div>
      <div class="industry-hero-gallery" aria-label="Component selection">
        {% set featured = industry.groups[0].items[0] %}<a class="industry-featured-part" href="/products/{{ featured.slug }}.html"><img src="{{ featured.image }}" alt="{{ featured.title }}" width="1200" height="675" fetchpriority="high" decoding="async" /><span><small>Custom metal components</small><strong>{{ featured.title }}</strong><b aria-hidden="true">↗</b></span></a>
        <div class="industry-mini-parts">{% for group in [industry.groups[1], industry.groups[2]] %}{% set part = group.items[0] %}<a href="/products/{{ part.slug }}.html"><img src="{{ part.imageSmall }}" alt="" width="640" height="360" decoding="async" /><span>{{ part.title }} <b aria-hidden="true">↗</b></span></a>{% endfor %}</div>
      </div>
    </div>
  </div>
</header>
<section class="industry-introduction"><div class="container industry-intro-grid"><div><span class="industry-kicker">Built around your assembly</span><h2>Metal components matched to your equipment</h2><p>{{ industry.definition }}</p></div><div class="industry-intro-notes"><div><h3>For your equipment team</h3><p>{{ industry.buyer }}</p></div><div><h3>Start with the mating view</h3><p>{{ industry.problem }}</p></div></div></div></section>
<section class="industry-catalog" id="components"><div class="container"><div class="industry-section-heading"><div><span class="industry-kicker">Choose your component</span><h2>{{ industry.subhead }}</h2></div><span class="industry-count">{{ industry.items.length }} component types</span></div><div class="industry-catalog-layout">
  <aside class="industry-catalog-sidebar"><nav class="industry-category-nav" aria-label="Component categories"><span>Browse by equipment</span>{% for group in industry.groups %}<a href="#component-group-{{ loop.index }}"{% if loop.first %} class="is-active" aria-current="location"{% endif %}><strong>{{ group.heading }}</strong><small>{{ group.items.length }}</small></a>{% endfor %}</nav><div class="industry-sidebar-help"><h3>Have a part drawing?</h3><p>Send it with the assembly view, quantity and finish.</p><a href="#quote">Discuss your part <span aria-hidden="true">↗</span></a></div></aside>
  <div class="industry-product-groups">{% for group in industry.groups %}<section class="steel-component-group industry-product-group" id="component-group-{{ loop.index }}"><div class="industry-group-heading"><span aria-hidden="true">0{{ loop.index }}</span><div><h3>{{ group.heading }}</h3><p>{{ group.intro }}</p></div></div><div class="product-grid catalogue-product-grid">{% for item in group.items %}<article class="product-card"><a href="/products/{{ item.slug }}.html" class="product-image" tabindex="-1" aria-hidden="true"><img src="{{ item.imageSmall }}" srcset="{{ item.imageSmall }} 640w, {{ item.image }} 1200w" sizes="(max-width:600px) 100vw, (max-width:1000px) 50vw, 430px" width="640" height="360" loading="lazy" decoding="async" alt="{{ item.title }}" /></a><div class="product-card-body"><h4><a href="/products/{{ item.slug }}.html">{{ item.title }}</a></h4><p class="industry-card-context"><span>Used in</span>{{ item.context }}</p><p class="industry-card-scope">{{ item.scope }}</p><a class="product-action industry-card-link" href="/products/{{ item.slug }}.html">View manufacturing details <span aria-hidden="true">↗</span></a></div></article>{% endfor %}</div></section>{% endfor %}</div>
</div></div></section>
<section class="industry-manufacturing" id="manufacturing"><div class="container"><div class="industry-section-heading"><div><span class="industry-kicker">Manufacturing capability</span><h2>From your drawing to finished metalwork</h2></div></div><div class="industry-manufacturing-grid"><figure class="industry-workshop"><img src="{{ industry.workshop.image }}" alt="{{ industry.workshop.alt }}" width="760" height="427" loading="lazy" decoding="async" /><figcaption>{{ industry.workshop.caption }}</figcaption></figure><div class="industry-process-list">{% for step in industry.process %}<div><span aria-hidden="true">0{{ loop.index }}</span><div><h3>{{ step[0] }}</h3><p>{{ step[1] }}</p></div></div>{% endfor %}<a class="industry-text-link" href="/marketing/contract_manufacturing/">See equipment and process capabilities <span aria-hidden="true">↗</span></a></div></div><p class="industry-scope-note">Order loose parts or a defined joined structure. The quotation identifies supplied hardware, finish, inspection and any external operations. Electronics, complete-system performance and product-specific qualification are included only under an agreed scope.</p></div></section>
<section id="inspection" class="industry-inspection"><div class="container"><div class="industry-section-heading"><div><span class="industry-kicker">Fit and acceptance</span><h2>Checks that follow the installed part</h2></div></div><div class="industry-check-grid">{% for check in industry.checks %}<div><span aria-hidden="true">0{{ loop.index }}</span><h3>{{ check[0] }}</h3><p>{{ check[1] }}</p></div>{% endfor %}</div></div></section>
<section class="industry-enquiry-section"><div class="container"><section class="industry-enquiry" id="quote"><div><span class="industry-kicker">Your next step</span><h2>Let’s review your part drawings.</h2><p>Include a dimensioned PDF, available STEP/DXF/DWG files, material, finish, quantity and delivery city. Add the assembly view, drawing revision and acceptance requirements.</p></div><div class="industry-enquiry-actions"><a class="button button-dark" href="mailto:sales@realjetech.com?subject={{ title | urlencode }}%20drawing%20enquiry">Email Your Drawings <span aria-hidden="true">↗</span></a><button class="button" type="button" data-universal-enquiry data-enquiry-keyword="{{ title }} manufacturing review">Enquiry →</button><p>Attach files in your email application. For confidential drawings, contact us first to arrange the exchange method and any required confidentiality agreement.</p></div></section></div></section>
<section class="industry-faq-section" id="faq"><div class="container industry-faq-layout"><div><span class="industry-kicker">Before you enquire</span><h2>Your manufacturing questions, answered.</h2><p>Clarify the supply scope and information needed for a drawing-based quote.</p></div><div class="industry-faq-list">{% for faq in industry.faqs %}<details{% if loop.first %} open{% endif %}><summary><h3>{{ faq[0] }}</h3><span aria-hidden="true">+</span></summary><p>{{ faq[1] }}</p></details>{% endfor %}</div></div></section>
</div>
