<article class="equipment-card">
  <a class="equipment-card-image" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    <img src="{{ product.data.image }}" alt="{{ product.data.imageAlt }}" width="640" height="400" loading="lazy" decoding="async" />
  </a>
  <div class="equipment-card-body">
    <h3><a href="{{ product.url }}">{{ product.data.title }}</a></h3>
    <p class="equipment-card-relevance">{{ relevance }}</p>
    <p class="equipment-card-inputs"><span class="equipment-card-inputs-label">Enquiry inputs</span> {{ selectionInputs }}</p>
    <a class="button button-dark equipment-card-action" href="{{ product.url }}" aria-label="View equipment details for {{ product.data.title }}">View equipment details <span aria-hidden="true">→</span></a>
  </div>
</article>
