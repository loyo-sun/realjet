<section class="mcap-section mcap-credentials" id="credentials"><div class="container">
  <div class="mcap-heading"><div><span class="mcap-eyebrow">Quality &amp; engineering credentials</span><h2>Quality systems.<br /> Documented engineering.</h2></div><div class="mcap-credential-intro"><p>Review our management-system certificates and selected welding and fixture patents, with original documents available below.</p><a class="mcap-brief-link" href="{{ manufacturingCredentials.brief }}" target="_blank" rel="noopener">Download credentials brief <span>PDF ↗</span></a></div></div>
  <div class="mcap-credential-holder"><span>Certificate holder</span><p>{{ manufacturingCredentials.holder }} <span lang="zh">{{ manufacturingCredentials.holderChinese }}</span></p></div>
  <nav class="mcap-credential-links" aria-label="Credential sections"><a href="#system-certificates">Management systems ↓</a><a href="#engineering-patents">Engineering patents ↓</a><a href="#company-recognition">Provincial recognition ↓</a></nav>
  <div class="mcap-certificate-grid" id="system-certificates">{% for certificate in manufacturingCredentials.certifications %}<article class="mcap-certificate-card">
    <button type="button" class="mcap-certificate-preview" data-credential-preview="{{ certificate.image }}" data-credential-title="{{ certificate.standard }} — {{ certificate.name }}" data-credential-original="{{ certificate.original }}" aria-label="Enlarge {{ certificate.standard }} certificate"><img src="{{ certificate.image }}" alt="Original {{ certificate.standard }} certificate issued to REALJET" width="1000" height="1414" loading="lazy" decoding="async" /><span>View certificate ↗</span></button>
    <div class="mcap-certificate-copy"><h3>{{ certificate.standard }}</h3><p class="mcap-certificate-name">{{ certificate.name }}</p><p class="mcap-certificate-scope">{{ certificate.scope }}</p><dl><div><dt>Certificate no.</dt><dd>{{ certificate.number }}</dd></div><div><dt>Issued</dt><dd>{{ certificate.issued }}</dd></div><div><dt>Expiry</dt><dd>{{ certificate.expires }}</dd></div></dl><a href="{{ certificate.original }}" target="_blank" rel="noopener">Open original document ↗</a></div>
  </article>{% endfor %}</div>
  <p class="mcap-credential-scope-note">Dates and scope are those printed on the supplied certificates. Certification applies to the activities stated in each document.</p>

  <div class="mcap-patent-heading" id="engineering-patents"><div><span class="mcap-eyebrow">Manufacturing engineering</span><h3>Welding, positioning and fixture development.</h3></div><p>Selected patent grant certificates document REALJET’s engineering work in workpiece clamping, robotic welding and positioning equipment.</p></div>
  <div class="mcap-patent-grid">{% for patent in manufacturingCredentials.patents %}<article class="mcap-patent-card"><button type="button" class="mcap-patent-preview" data-credential-preview="{{ patent.image }}" data-credential-title="{{ patent.title }} — {{ patent.number }}" data-credential-original="{{ patent.original }}" aria-label="Enlarge {{ patent.number }} patent certificate"><img src="{{ patent.image }}" alt="{{ patent.type }} grant certificate for {{ patent.originalTitle }}" width="1000" height="1414" loading="lazy" decoding="async" /></button><div class="mcap-patent-copy"><span class="mcap-patent-type">{{ patent.type }}</span><h4>{{ patent.title }}</h4><p class="mcap-patent-number">{{ patent.number }}</p><p class="mcap-patent-grant">Grant date: {{ patent.granted }}</p><p class="mcap-patent-focus">{{ patent.focus }}</p><a href="{{ patent.original }}" target="_blank" rel="noopener">View grant document ↗</a></div></article>{% endfor %}</div>
  <p class="mcap-credential-scope-note">Patent details reflect the supplied grant certificates. Product specifications and acceptance requirements are agreed for each order.</p>

  <div class="mcap-recognition" id="company-recognition"><button type="button" data-credential-preview="{{ manufacturingCredentials.recognition.image }}" data-credential-title="{{ manufacturingCredentials.recognition.title }} — {{ manufacturingCredentials.recognition.period }}" data-credential-original="{{ manufacturingCredentials.recognition.original }}" aria-label="Enlarge Hunan specialized and innovative SME recognition"><img src="{{ manufacturingCredentials.recognition.image }}" alt="Plaque recognising REALJET as a Hunan specialized and innovative SME for 2025-2028" width="1000" height="700" loading="lazy" /></button><div><span class="mcap-eyebrow">Provincial recognition</span><h3>{{ manufacturingCredentials.recognition.title }}</h3><p>{{ manufacturingCredentials.recognition.authority }}<br /> Recognition period shown: {{ manufacturingCredentials.recognition.period }}</p><a href="{{ manufacturingCredentials.recognition.original }}" target="_blank" rel="noopener">View recognition document ↗</a></div><a class="mcap-recognition-brief" href="{{ manufacturingCredentials.brief }}" target="_blank" rel="noopener">Download<br /> the credentials brief ↗</a></div>
</div></section>
<dialog class="mcap-document-dialog" data-credential-dialog aria-labelledby="mcap-document-title"><div class="mcap-document-toolbar"><h2 id="mcap-document-title" data-credential-dialog-title>Credential document</h2><button type="button" data-credential-close aria-label="Close credential preview">Close ×</button></div><div class="mcap-document-image"><img data-credential-dialog-image alt="" /></div><a data-credential-dialog-original href="#" target="_blank" rel="noopener">Open original document ↗</a></dialog>
