---
layout: layouts/base.njk
---
<style>.product-page .product-overview-copy h1{border:0;padding-bottom:0}@media(max-width:768px){.product-overview-copy{order:-1}}</style>
<article class="product-page{% if steelComponentProduct %} product-page-steel-component{% endif %}{% if sheetMetalProduct %} product-page-sheet-metal{% endif %}{% if productSeries == "spun-pile-equipment" %} product-page-spun-equipment{% endif %}">
  {% set application = steelApplications[slug] %}
  <header class="product-page-heading">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span>{% if productSeries == "precast-concrete-moulds" %}<a href="/precast-concrete-molds/">Precast Concrete Moulds</a>{% else %}<a href="/products/">Products</a>{% endif %}<span aria-hidden="true">/</span>{% if productSeries == "contract-manufacturing" %}<a href="/products/custom-machinery-components/">Custom Machinery Components</a><span aria-hidden="true">/</span>{% endif %}<span aria-current="page">{{ title }}</span></nav>
    </div>
  </header>
  <div class="container product-detail-shell">
    <section class="product-overview">
      <figure class="product-gallery" style="margin:0;min-width:0">
        <div class="product-gallery-stage"><img src="{{ image }}" srcset="{{ imageSmall }} 640w, {{ image }} 1440w" sizes="(max-width:768px) 100vw, 60vw" alt="{{ imageAlt }}" width="1440" height="810" fetchpriority="high" decoding="async" style="object-fit:contain" /></div>
      </figure>
      <div class="product-overview-copy">
        <span class="eyebrow">Made to your equipment drawings</span>
        <h1>{{ customHeading }}</h1>
        <p>{{ description }}</p>
        <div class="product-conversion-actions">
          <button class="button button-dark" type="button" data-universal-enquiry data-enquiry-keyword="Product enquiry: {{ title }}" data-product-conversion data-conversion-type="enquiry" data-conversion-position="overview">Enquiry <span aria-hidden="true">→</span></button>
          <a class="button product-whatsapp-button" href="https://wa.me/8619310090600?text=Hello%2C%20I%20would%20like%20to%20enquire%20about%20this%20product%3A%20{{ title | urlencode }}%0A{{ canonical | urlencode }}%0AChannel%3A%20website" target="_blank" rel="noopener noreferrer" data-product-conversion data-conversion-type="whatsapp" data-conversion-position="overview">WhatsApp <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>


    <div class="product-detail-content-layout">
      <div class="product-description article-body">
        {% if solutionUrl %}
        <div class="product-solution-card">
          <img class="product-solution-image" src="/images/products/spun-pile-line.webp" alt="Spun concrete pile production workshop with blue steel moulds and overhead handling equipment" width="1600" height="900" loading="lazy" decoding="async" />
          <div class="product-solution-copy">
            <span class="product-solution-eyebrow">Complete production line solution</span>
            <strong>{{ solutionTitle }}</strong>
            <p>See how this equipment fits into the line, from reinforcement preparation to forming, curing and handling.</p>
            <a class="button button-dark product-solution-button" href="{{ solutionUrl }}">Explore the production line</a>
          </div>
        </div>
        {% endif %}
        {{ content | safe }}
        {% if productSeries == "precast-concrete-moulds" %}
        <figure class="product-about-image">
          <img src="/images/company/about-realjet.webp" alt="Realjet headquarters, manufacturing workshop and company honor display" width="1824" height="1026" loading="lazy" decoding="async" />
        </figure>
        {% endif %}
      </div>
    </div>
  </div>

  {% include "components/product-topic-band.njk" %}
</article>
