<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="{{ robots or 'index, follow' }}" />
    <meta name="description" content="{{ description or site.defaultDescription }}" />
    <link rel="canonical" href="{{ canonical }}" />
    <meta name="theme-color" content="#08253f" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/icons/realjet-site-icon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/icons/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Realjet Insights" href="/feed.xml" />
    <meta property="og:type" content="{% if pageType == 'insight' %}article{% else %}website{% endif %}" />
    <meta property="og:site_name" content="Realjet" />
    <meta property="og:title" content="{{ seoTitle or title }}" />
    <meta property="og:description" content="{{ description or site.defaultDescription }}" />
    <meta property="og:url" content="{{ canonical }}" />
    <meta property="og:image" content="{{ socialImage or site.socialImage }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ seoTitle or title }}" />
    <meta name="twitter:description" content="{{ description or site.defaultDescription }}" />
    <meta name="twitter:image" content="{{ socialImage or site.socialImage }}" />
    <title>{{ seoTitle or title }}</title>
    <link rel="stylesheet" href="/assets/site/site.css" />
    {% if pageType == "home" %}
    <script type="application/ld+json">
      {
        "@context":"https://schema.org",
        "@graph":[
          {"@type":"Organization","@id":"https://realjetech.com/#organization","name":"{{ site.legalName }}","alternateName":"Realjet","url":"{{ site.url }}","logo":"https://realjetech.com/images/realjet-logo.webp","email":"mailto:{{ site.email }}","description":{{ site.defaultDescription | json | safe }},"knowsAbout":["Precast concrete production lines","Precast concrete equipment","Custom machinery component manufacturing","Bridge girder production"]},
          {"@type":"WebSite","@id":"https://realjetech.com/#website","url":"{{ site.url }}","name":"Realjet","publisher":{"@id":"https://realjetech.com/#organization"},"inLanguage":"en"}
        ]
      }
    </script>
    {% endif %}
    {% if pageType == "contact" %}
    <script type="application/ld+json">
      {
        "@context":"https://schema.org",
        "@type":"ContactPage",
        "name":"Contact Realjet",
        "url":"https://realjetech.com/contact/",
        "mainEntity":{
          "@type":"Organization",
          "name":"{{ site.legalName }}",
          "alternateName":"Realjet",
          "url":"{{ site.url }}",
          "email":"mailto:{{ site.email }}",
          "address":{
            "@type":"PostalAddress",
            "streetAddress":"{{ site.addressDetails.streetAddress }}",
            "addressLocality":"{{ site.addressDetails.addressLocality }}",
            "addressRegion":"{{ site.addressDetails.addressRegion }}",
            "postalCode":"{{ site.addressDetails.postalCode }}",
            "addressCountry":"{{ site.addressDetails.addressCountry }}"
          }
        }
      }
    </script>
    {% endif %}
    {% if pageType == "insight" %}
    <script type="application/ld+json">
      {
        "@context":"https://schema.org",
        "@graph":[
          {"@type":"Article","headline":{{ title | json | safe }},"description":{{ description | json | safe }},"datePublished":"{{ date | isoDate }}","dateModified":"{{ (updated or date) | isoDate }}","mainEntityOfPage":{{ canonical | json | safe }},"image":{{ socialImage | json | safe }},"author":{"@type":"Organization","name":"{{ site.legalName }}"},"publisher":{"@type":"Organization","name":"{{ site.legalName }}","logo":{"@type":"ImageObject","url":"https://realjetech.com/images/realjet-logo.webp"}},"inLanguage":"en"},
          {"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://realjetech.com/"},{"@type":"ListItem","position":2,"name":"Insights","item":"https://realjetech.com/insights/"},{"@type":"ListItem","position":3,"name":{{ title | json | safe }},"item":{{ canonical | json | safe }}}]}
        ]
      }
    </script>
    {% endif %}
    {% if pageType == "product" %}
    <script type="application/ld+json">
      {
        "@context":"https://schema.org",
        "@graph":[
          {"@type":"Product","name":{{ title | json | safe }},"description":{{ description | json | safe }},"image":{{ socialImage | json | safe }},"url":{{ canonical | json | safe }},"brand":{"@type":"Brand","name":"Realjet"}},
          {"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://realjetech.com/"},{"@type":"ListItem","position":2,"name":"{% if productSeries == 'precast-concrete-moulds' %}Precast Concrete Moulds{% else %}Products{% endif %}","item":"{% if productSeries == 'precast-concrete-moulds' %}https://realjetech.com/precast-concrete-molds/{% else %}https://realjetech.com/products/{% endif %}"},{"@type":"ListItem","position":3,"name":{{ title | json | safe }},"item":{{ canonical | json | safe }}}]}
        ]
      }
    </script>
    {% endif %}
    {% if pageType == "precast-moulds" or pageType == "precast-mould-category" %}
    <script type="application/ld+json">
      {
        "@context":"https://schema.org",
        "@type":"CollectionPage",
        "name":{{ (seoTitle or title) | json | safe }},
        "description":{{ description | json | safe }},
        "url":{{ canonical | json | safe }},
        "isPartOf":{"@type":"WebSite","name":"Realjet","url":"https://realjetech.com/"},
        "about":{"@type":"Product","name":"Precast Concrete Moulds and Formwork","brand":{"@type":"Brand","name":"Realjet"}},
        "inLanguage":"en"
      }
    </script>
    {% endif %}
  </head>
  <body data-page-type="{{ pageType or 'page' }}"{% if pageType == "insight" and slug %} data-article-slug="{{ slug }}"{% endif %}{% if pageType == "product" and slug %} data-product-slug="{{ slug }}"{% endif %}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {% include "components/header.njk" %}
    <main id="main-content">{{ content | safe }}</main>
    {% include "components/universal-enquiry-modal.njk" %}
    {% include "components/footer.njk" %}
    <script src="/assets/site/site.js" defer></script>
  </body>
</html>
