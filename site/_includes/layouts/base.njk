<!doctype html>
<html lang="en">
  <head>
    <script>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function gtagQueue(){ window.dataLayer.push(arguments); };
      window.gtag("consent", "default", {
        analytics_storage: "denied",
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        wait_for_update: 500
      });
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="{{ robots or 'index, follow' }}" />
    <meta name="description" content="{{ description or site.defaultDescription }}" />
    <link rel="canonical" href="{{ canonical }}" />
    {% if catalogue %}
    {% if catalogue.previousUrl %}<link rel="prev" href="{{ catalogue.previousUrl | absoluteUrl(site.url) }}" />{% endif %}
    {% if catalogue.nextUrl %}<link rel="next" href="{{ catalogue.nextUrl | absoluteUrl(site.url) }}" />{% endif %}
    {% else %}
    {% if pagination and pagination.href.previous %}<link rel="prev" href="{{ pagination.href.previous | absoluteUrl(site.url) }}" />{% endif %}
    {% if pagination and pagination.href.next %}<link rel="next" href="{{ pagination.href.next | absoluteUrl(site.url) }}" />{% endif %}
    {% endif %}
    <meta name="theme-color" content="#08253f" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/icons/realjet-site-icon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/icons/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Realjet Insights" href="/feed.xml" />
    <meta property="og:type" content="{% if pageType == 'insight' %}article{% else %}website{% endif %}" />
    <meta property="og:site_name" content="Realjet" />
    <meta property="og:title" content="{{ seoTitle or title }}" />
    <meta property="og:description" content="{{ description or site.defaultDescription }}" />
    <meta property="og:url" content="{{ canonical }}" />
    <meta property="og:image" content="{{ socialImage or site.socialImage }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ seoTitle or title }}" />
    <meta name="twitter:description" content="{{ description or site.defaultDescription }}" />
    <meta name="twitter:image" content="{{ socialImage or site.socialImage }}" />
    <title>{{ seoTitle or title }}</title>
    <link rel="stylesheet" href="/assets/site/site.css" />
    {% if pageType == "concrete-lab" %}
    <link rel="stylesheet" href="/assets/site/concrete-lab.css" />
    <script src="/assets/site/concrete-lab.js" defer></script>
    {% endif %}
    {% if pageType == "ppvc-line" %}
    <link rel="preload" as="image" href="/images/ppvc-line/hero-panoramic-plant.webp" fetchpriority="high" />
    <link rel="stylesheet" href="/assets/site/ppvc.css" />
    <script src="/assets/site/ppvc.js" defer></script>
    {% endif %}
    {% if pageType == "home" %}
    <script type="application/ld+json">
      {
        "@context":"https://schema.org",
        "@graph":[
          {"@type":"Organization","@id":"https://realjetech.com/#organization","name":"{{ site.legalName }}","alternateName":"Realjet","url":"{{ site.url }}","logo":"https://realjetech.com/images/realjet-logo.webp","email":"mailto:{{ site.email }}","description":{{ site.defaultDescription | json | safe }},"knowsAbout":["Precast concrete production lines","Precast concrete equipment","Custom machinery component manufacturing","Bridge girder production"]},
          {"@type":"WebSite","@id":"https://realjetech.com/#website","url":"{{ site.url }}","name":"Realjet","publisher":{"@id":"https://realjetech.com/#organization"},"inLanguage":"en"}
        ]
      }
    </script>
    {% endif %}
    {% if pageType == "contact" %}
    <script type="application/ld+json">
      {
        "@context":"https://schema.org",
        "@type":"ContactPage",
        "name":"Contact Realjet",
        "url":"https://realjetech.com/contact/",
        "mainEntity":{
          "@type":"Organization",
          "name":"{{ site.legalName }}",
          "alternateName":"Realjet",
          "url":"{{ site.url }}",
          "email":"mailto:{{ site.email }}",
          "address":{
            "@type":"PostalAddress",
            "streetAddress":"{{ site.addressDetails.streetAddress }}",
            "addressLocality":"{{ site.addressDetails.addressLocality }}",
            "addressRegion":"{{ site.addressDetails.addressRegion }}",
            "postalCode":"{{ site.addressDetails.postalCode }}",
            "addressCountry":"{{ site.addressDetails.addressCountry }}"
          }
        }
      }
    </script>
    {% endif %}
    {% if pageType == "insight" %}
    <script type="application/ld+json">
      {
        "@context":"https://schema.org",
        "@graph":[
          {"@type":"Article","headline":{{ title | json | safe }},"description":{{ description | json | safe }},"datePublished":"{{ date | isoDate }}","dateModified":"{{ (updated or date) | isoDate }}","mainEntityOfPage":{{ canonical | json | safe }},"image":{{ socialImage | json | safe }},"author":{"@type":"Organization","name":"{{ site.legalName }}"},"publisher":{"@type":"Organization","name":"{{ site.legalName }}","logo":{"@type":"ImageObject","url":"https://realjetech.com/images/realjet-logo.webp"}},"inLanguage":"en"},
          {"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://realjetech.com/"},{"@type":"ListItem","position":2,"name":"Insights","item":"https://realjetech.com/insights/"},{"@type":"ListItem","position":3,"name":{{ title | json | safe }},"item":{{ canonical | json | safe }}}]}
        ]
      }
    </script>
    {% endif %}
    {% if catalogue %}
    <script type="application/ld+json">
      {"@context":"https://schema.org","@graph":[
        {"@type":"CollectionPage","name":{{ seoTitle | json | safe }},"description":{{ description | json | safe }},"url":{{ canonical | json | safe }},"inLanguage":"en","mainEntity":{"@id":"{{ canonical }}#product-list"}},
        {"@type":"ItemList","@id":"{{ canonical }}#product-list","numberOfItems":{{ catalogue.products.length }},"itemListElement":[{% for product in catalogue.products %}{"@type":"ListItem","position":{{ catalogue.start + loop.index0 }},"name":{{ product.data.title | json | safe }},"url":{{ product.url | absoluteUrl(site.url) | json | safe }}}{% if not loop.last %},{% endif %}{% endfor %}]}
        ,{"@type":"BreadcrumbList","itemListElement":{{ catalogue.breadcrumbs | json | safe }}}
      ]}
    </script>
    {% endif %}
    {% if pageType == "product" %}
    <script type="application/ld+json">
      {
        "@context":"https://schema.org",
        "@graph":[
          {# Enquiry-only pages have no published price or reviews for Product rich results. #}
          {"@type":"WebPage","name":{{ title | json | safe }},"description":{{ description | json | safe }},"image":{{ socialImage | json | safe }},"url":{{ canonical | json | safe }},"inLanguage":"en"{% if productSeries == "contract-manufacturing" %},"mainEntity":{"@type":"Service","name":{{ title | json | safe }},"description":{{ description | json | safe }},"url":{{ canonical | json | safe }},"serviceType":{{ (manufacturingServiceType or "Contract manufacturing") | json | safe }},"provider":{"@type":"Organization","name":{{ site.legalName | json | safe }},"alternateName":"Realjet","url":"https://realjetech.com/"}}{% endif %}},
          {"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://realjetech.com/"},{"@type":"ListItem","position":2,"name":"{% if productSeries == 'precast-concrete-moulds' %}Precast Concrete Moulds{% else %}Products{% endif %}","item":"{% if productSeries == 'precast-concrete-moulds' %}https://realjetech.com/precast-concrete-molds/{% else %}https://realjetech.com/products/{% endif %}"},{% if productSeries == "contract-manufacturing" %}{"@type":"ListItem","position":3,"name":"Custom Machinery Components","item":"https://realjetech.com/products/custom-machinery-components/"},{% endif %}{"@type":"ListItem","position":{% if productSeries == "contract-manufacturing" %}4{% else %}3{% endif %},"name":{{ title | json | safe }},"item":{{ canonical | json | safe }}}]}
        ]
      }
    </script>
    {% endif %}
    {% if pageType == "precast-moulds" or pageType == "precast-mould-category" %}
    <script type="application/ld+json">
      {
        "@context":"https://schema.org",
        "@type":"CollectionPage",
        "name":{{ (seoTitle or title) | json | safe }},
        "description":{{ description | json | safe }},
        "url":{{ canonical | json | safe }},
        "isPartOf":{"@type":"WebSite","name":"Realjet","url":"https://realjetech.com/"},
        "about":{"@type":"Thing","name":"Precast Concrete Moulds and Formwork"},
        "inLanguage":"en"
      }
    </script>
    {% endif %}
  </head>
  <body data-page-type="{{ pageType or 'page' }}"{% if sheetMetalProduct %} data-sheet-metal-product="true"{% endif %}{% if pageType == "insight" and slug %} data-article-slug="{{ slug }}"{% endif %}{% if pageType == "product" and slug %} data-product-slug="{{ slug }}"{% endif %}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {% include "components/header.njk" %}
    <main id="main-content">{{ content | safe }}</main>
    {% include "components/floating-contact-actions.njk" %}
    {% include "components/universal-enquiry-modal.njk" %}
    {% include "components/footer.njk" %}
    <script src="/assets/site/site.js" defer></script>
  </body>
</html>
