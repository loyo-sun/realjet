---
layout: layouts/base.njk
---
<article class="product-page">
  <header class="product-page-heading">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span>{% if productSeries == "precast-concrete-moulds" %}<a href="/precast-concrete-molds/">Precast Concrete Moulds</a>{% else %}<a href="/products/">Products</a>{% endif %}<span aria-hidden="true">/</span><span aria-current="page">{{ title }}</span></nav>
    </div>
  </header>
  <div class="container product-detail-shell">
    <section class="product-overview">
      <div class="product-gallery" data-product-gallery>
        <div class="product-gallery-stage"><img src="{{ image }}" alt="{{ imageAlt }}" width="1200" height="675" decoding="async" data-product-gallery-main /></div>
        {% if gallery and gallery.length %}
        <div class="product-gallery-thumbs" aria-label="Product image gallery">
          <button type="button" class="is-active" aria-pressed="true" aria-label="View main product image" data-product-gallery-thumb data-gallery-src="{{ image }}" data-gallery-alt="{{ imageAlt }}" data-gallery-position="1"><img src="{{ image }}" alt="" width="160" height="90" loading="lazy" decoding="async" /></button>
          {% for galleryImage in gallery %}
          <button type="button" aria-pressed="false" aria-label="View product image {{ loop.index + 1 }}" data-product-gallery-thumb data-gallery-src="{{ galleryImage.image }}" data-gallery-alt="{{ galleryImage.alt }}" data-gallery-position="{{ loop.index + 1 }}"><img src="{{ galleryImage.image }}" alt="" width="160" height="90" loading="lazy" decoding="async" /></button>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      <div class="product-overview-copy">
        <span class="eyebrow">{% if productSeries == "contract-manufacturing" %}Contract Manufacturing{% elseif productSeries == "precast-concrete-moulds" %}Precast Concrete Moulds{% else %}Precast Production Equipment{% endif %}</span>
        <h1>{{ title }}</h1>
        <p>{{ description }}</p>
        <div class="product-conversion-actions">
          <button class="button button-dark" type="button" data-universal-enquiry data-enquiry-keyword="Product enquiry: {{ title }}" data-product-conversion data-conversion-type="enquiry" data-conversion-position="overview">Enquiry <span aria-hidden="true">→</span></button>
          <a class="button product-whatsapp-button" href="https://wa.me/8619310090600?text=Hello%2C%20I%20would%20like%20to%20enquire%20about%20this%20product%3A%20{{ title | urlencode }}%0A{{ canonical | urlencode }}%0AChannel%3A%20website" target="_blank" rel="noopener noreferrer" data-product-conversion data-conversion-type="whatsapp" data-conversion-position="overview">WhatsApp <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <div class="product-detail-content-layout">
      <div class="product-description article-body">{{ content | safe }}</div>
      {% include "components/latest-products.njk" %}
    </div>
  </div>

  {% include "components/business-promos.njk" %}
  <nav class="insight-contact-actions product-contact-actions" aria-label="Product contact options">
    <button type="button" data-universal-enquiry data-enquiry-keyword="Product enquiry: {{ title }}" data-product-conversion data-conversion-type="enquiry" data-conversion-position="floating" aria-label="Enquiry" title="Enquiry">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/><path d="M8 9h8M8 13h5"/></svg>
    </button>
    <a href="mailto:sales@realjetech.com?subject=Product%20enquiry%3A%20{{ title | urlencode }}&amp;body=Hello%2C%20I%20would%20like%20to%20enquire%20about%20this%20product%3A%0A{{ canonical | urlencode }}%0A%0AChannel%3A%20website" data-product-conversion data-conversion-type="email" data-conversion-position="floating" aria-label="E-mail" title="E-mail">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
    </a>
    <a href="https://wa.me/8619310090600?text=Hello%2C%20I%20would%20like%20to%20enquire%20about%20this%20product%3A%20{{ title | urlencode }}%0A{{ canonical | urlencode }}%0AChannel%3A%20website" target="_blank" rel="noopener noreferrer" data-product-conversion data-conversion-type="whatsapp" data-conversion-position="floating" aria-label="WhatsApp" title="WhatsApp">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.5L3 20.5l1.3-4.7a8.5 8.5 0 1 1 16.2-4.2z"/><path d="M8.2 7.7c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.8 1.9c.1.3.1.5-.1.7l-.6.7c-.2.2-.1.4 0 .6.7 1.2 1.7 2.1 2.9 2.7.2.1.4.1.6-.1l.8-1c.2-.2.4-.3.7-.2l2 .9c.3.1.4.3.4.5 0 .3-.2 1.5-1.1 2.1-.6.4-1.4.6-2.3.3-1-.3-2.4-.8-4.1-2.3-1.4-1.2-2.4-2.7-2.7-3.7-.7-1.9.2-2.9.5-3.1z"/></svg>
    </a>
  </nav>
</article>
