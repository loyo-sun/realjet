---
layout: layouts/base.njk
---
<article class="product-page">
  <header class="product-page-heading">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span>{% if productSeries == "precast-concrete-moulds" %}<a href="/precast-concrete-molds/">Precast Concrete Moulds</a>{% else %}<a href="/products/">Products</a>{% endif %}<span aria-hidden="true">/</span><span aria-current="page">{{ title }}</span></nav>
    </div>
  </header>
  <div class="container product-detail-shell">
    <section class="product-overview">
      <div class="product-gallery" data-product-gallery>
        <div class="product-gallery-stage"><img src="{{ image }}" alt="{{ imageAlt }}" width="1200" height="675" decoding="async" data-product-gallery-main /></div>
        {% if gallery and gallery.length %}
        <div class="product-gallery-thumbs" aria-label="Product image gallery">
          <button type="button" class="is-active" aria-pressed="true" aria-label="View main product image" data-product-gallery-thumb data-gallery-src="{{ image }}" data-gallery-alt="{{ imageAlt }}" data-gallery-position="1"><img src="{{ image }}" alt="" width="160" height="90" loading="lazy" decoding="async" /></button>
          {% for galleryImage in gallery %}
          <button type="button" aria-pressed="false" aria-label="View product image {{ loop.index + 1 }}" data-product-gallery-thumb data-gallery-src="{{ galleryImage.image }}" data-gallery-alt="{{ galleryImage.alt }}" data-gallery-position="{{ loop.index + 1 }}"><img src="{{ galleryImage.image }}" alt="" width="160" height="90" loading="lazy" decoding="async" /></button>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      <div class="product-overview-copy">
        <span class="eyebrow">{% if productSeries == "contract-manufacturing" %}Contract Manufacturing{% elseif productSeries == "precast-concrete-moulds" %}Precast Concrete Moulds{% else %}Precast Production Equipment{% endif %}</span>
        <h1>{{ title }}</h1>
        <p>{{ description }}</p>
        <button class="button button-dark" type="button" data-universal-enquiry data-enquiry-keyword="Product enquiry: {{ title }}">Enquire About This Product <span aria-hidden="true">→</span></button>
      </div>
    </section>

    <div class="product-detail-content-layout">
      <div class="product-description article-body">{{ content | safe }}</div>
      {% include "components/latest-products.njk" %}
    </div>
  </div>

  {% include "components/business-promos.njk" %}
</article>
