---
layout: layouts/base.njk
---
<article class="wall-panel-lp">
  <header class="wall-lp-hero">
    <img class="wall-lp-hero-background" src="{{ image }}" alt="" aria-hidden="true" width="1600" height="900" decoding="async" />
    <div class="wall-lp-hero-overlay" aria-hidden="true"></div>
    <div class="container wall-lp-hero-shell">
      <div class="wall-lp-hero-copy">
        <span class="eyebrow">Precast Concrete Wall Panel Moulds</span>
        <h1>{{ heroTitle or title }}</h1>
        <p>{{ description }}</p>
        <ul class="wall-lp-scope-list" aria-label="Supported wall panel project directions">
          <li>Horizontal casting systems</li>
          <li>Vertical casting systems</li>
          <li>Structural, facade and sandwich panels</li>
        </ul>
        <button class="button button-primary" type="button" data-universal-enquiry data-enquiry-keyword="Wall panel mould project" data-enquiry-title="Tell Us About Your Wall Panel Project" data-enquiry-placeholder="What type of wall panels do you plan to produce? Approximate dimensions, target output or drawings can be shared if available." data-enquiry-submit-label="Contact Realjet" data-product-conversion data-conversion-type="enquiry" data-conversion-position="hero">Discuss Your Project <span aria-hidden="true">→</span></button>
        <small>Drawings are helpful, but not required for the first discussion.</small>
      </div>
    </div>
  </header>

  <div class="wall-lp-main">
    {{ content | safe }}
  </div>

  <section class="wall-lp-final" aria-labelledby="wall-lp-final-title">
    <div class="container wall-lp-final-card">
      <div>
        <span class="eyebrow">Start with a simple message</span>
        <h2 id="wall-lp-final-title">Tell Us About the Wall Panels You Plan to Produce</h2>
        <p>You do not need to know the final mould configuration. Describe the product or project, and our team will contact you to discuss the suitable next step.</p>
      </div>
      <button class="button button-primary" type="button" data-universal-enquiry data-enquiry-keyword="Wall panel mould project" data-enquiry-title="Tell Us About Your Wall Panel Project" data-enquiry-placeholder="What type of wall panels do you plan to produce? Approximate dimensions, target output or drawings can be shared if available." data-enquiry-submit-label="Contact Realjet" data-product-conversion data-conversion-type="enquiry" data-conversion-position="final">Discuss Your Project <span aria-hidden="true">→</span></button>
    </div>
  </section>

</article>
