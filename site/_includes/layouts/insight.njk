---
layout: layouts/base.njk
---
<article class="article-page">
  <header class="article-hero">
    <div class="article-hero-media" aria-hidden="true">{% responsiveImage image, "", "eager", "100vw" %}</div>
    <div class="article-hero-overlay"></div>
    <div class="article-shell">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/insights/">Insights</a><span aria-hidden="true">/</span><span aria-current="page">{{ title }}</span></nav>
      <h1>{{ title }}</h1>
      <p class="article-deck">{{ description }}</p>
      <div class="article-meta">
        <span>Published <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time></span>
        {% if updated and (updated | isoDate) != (date | isoDate) %}<span>Updated <time datetime="{{ updated | isoDate }}">{{ updated | readableDate }}</time></span>{% endif %}
      </div>
    </div>
  </header>
  <div class="article-layout container">
    <div class="article-body">{{ content | safe }}</div>
    <aside class="article-aside" aria-label="Related content">
      <section class="article-aside-card latest-news-card" aria-labelledby="latest-news-title">
        <span class="eyebrow">Latest News</span>
        <h2 id="latest-news-title">Latest Insights</h2>
        <nav class="latest-news-list" aria-label="Latest news">
          {% for news in collections.publishedInsights | excludeInsightSlug(slug) | limit(5) %}
            <a href="{{ news.url }}" data-insight-card data-insight-slug="{{ news.data.slug }}" data-insight-position="sidebar">
              <img src="{{ news.data.image }}" alt="" width="68" height="68" loading="lazy" decoding="async">
              <span>
                <time datetime="{{ news.data.date | isoDate }}">{{ news.data.date | readableDate }}</time>
                <strong>{{ news.data.title }}</strong>
              </span>
            </a>
          {% endfor %}
        </nav>
      </section>
    </aside>
  </div>
  {% include "components/business-promos.njk" %}
  <nav class="insight-contact-actions" aria-label="Contact Realjet">
    <a href="https://realjetech.com/contact/" data-insight-cta data-cta-type="inquiry" data-channel="website" aria-label="Enquiry" title="Enquiry">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/><path d="M8 9h8M8 13h5"/></svg>
    </a>
    <a href="https://wa.me/8619310090600?text=Hello%2C%20I%20would%20like%20to%20revise%20the%20content%20for%20further%20discussion%3A%20{{ canonical }}%0AChannel%3A%20website" target="_blank" rel="noopener noreferrer" data-insight-cta data-cta-type="whatsapp" data-channel="website" aria-label="WhatsApp" title="WhatsApp">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.5L3 20.5l1.3-4.7a8.5 8.5 0 1 1 16.2-4.2z"/><path d="M8.2 7.7c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.8 1.9c.1.3.1.5-.1.7l-.6.7c-.2.2-.1.4 0 .6.7 1.2 1.7 2.1 2.9 2.7.2.1.4.1.6-.1l.8-1c.2-.2.4-.3.7-.2l2 .9c.3.1.4.3.4.5 0 .3-.2 1.5-1.1 2.1-.6.4-1.4.6-2.3.3-1-.3-2.4-.8-4.1-2.3-1.4-1.2-2.4-2.7-2.7-3.7-.7-1.9.2-2.9.5-3.1z"/></svg>
    </a>
    <a href="mailto:sales@realjetech.com?subject=Website%20insight%20enquiry&amp;body=Hello%2C%20I%20would%20like%20to%20discuss%20this%20content%3A%20{{ canonical }}%0A%0AChannel%3A%20website" data-insight-cta data-cta-type="email" data-channel="website" aria-label="E-mail" title="E-mail">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
    </a>
  </nav>
</article>
