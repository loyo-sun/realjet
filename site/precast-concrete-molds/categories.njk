---
pagination:
  data: precastMouldCatalog.categories
  size: 1
  alias: mouldCategory
permalink: "/precast-concrete-molds/{{ mouldCategory.slug }}/index.html"
layout: layouts/base.njk
pageType: precast-mould-category
robots: index, follow
eleventyComputed:
  title: "{{ mouldCategory.name | safe }} | Realjet"
  seoTitle: "{{ mouldCategory.name | safe }} for Precast Concrete | Realjet"
  description: "{{ mouldCategory.description }}"
  canonical: "https://realjetech.com/precast-concrete-molds/{{ mouldCategory.slug }}/"
---
{% set categoryProducts = collections.publishedMouldProducts | mouldProductsForCategory(mouldCategory.slug) %}
<header class="listing-hero category-listing-hero">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/precast-concrete-molds/">Precast Concrete Moulds</a><span aria-hidden="true">/</span><span aria-current="page">{{ mouldCategory.name }}</span></nav>
    <span class="eyebrow">Precast Mould Category</span>
    <h1>{{ mouldCategory.name }}</h1>
    <p>{{ mouldCategory.description }}</p>
  </div>
</header>
<section class="mould-products-section">
  <div class="container">
    <div class="mould-products-grid" style="--mould-columns: {{ categoryProducts.length }}">
      {% for mouldProduct in categoryProducts %}{% include "components/mould-product-card.njk" %}{% endfor %}
    </div>
  </div>
</section>
<section class="category-contact-band">
  <div class="container category-contact-inner">
    <div><span class="eyebrow">Project Review</span><h2>Start with the component drawings and production plan.</h2></div>
    <button class="button button-primary" type="button" data-universal-enquiry data-enquiry-keyword="{{ mouldCategory.name }} enquiry">Send Project Requirements <span aria-hidden="true">→</span></button>
  </div>
</section>
<nav class="insight-contact-actions category-contact-actions" aria-label="{{ mouldCategory.name }} contact options">
  <button type="button" data-universal-enquiry data-enquiry-keyword="{{ mouldCategory.name }} enquiry" data-mould-cta="category_floating_enquiry" aria-label="Enquire about {{ mouldCategory.name }}" title="Enquire">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/><path d="M8 9h8M8 13h5"/></svg>
    <span class="category-action-label">Enquire</span>
  </button>
  <a href="https://wa.me/8619310090600?text=Hello%2C%20I%20would%20like%20to%20enquire%20about%20{{ mouldCategory.name | urlencode }}%3A%0A{{ canonical | urlencode }}%0AChannel%3A%20website" target="_blank" rel="noopener noreferrer" data-mould-cta="category_floating_whatsapp" aria-label="Contact Realjet about {{ mouldCategory.name }} on WhatsApp" title="WhatsApp">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.5L3 20.5l1.3-4.7a8.5 8.5 0 1 1 16.2-4.2z"/><path d="M8.2 7.7c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.8 1.9c.1.3.1.5-.1.7l-.6.7c-.2.2-.1.4 0 .6.7 1.2 1.7 2.1 2.9 2.7.2.1.4.1.6-.1l.8-1c.2-.2.4-.3.7-.2l2 .9c.3.1.4.3.4.5 0 .3-.2 1.5-1.1 2.1-.6.4-1.4.6-2.3.3-1-.3-2.4-.8-4.1-2.3-1.4-1.2-2.4-2.7-2.7-3.7-.7-1.9.2-2.9.5-3.1z"/></svg>
    <span class="category-action-label">WhatsApp</span>
  </a>
  <a href="mailto:sales@realjetech.com?subject={{ mouldCategory.name | urlencode }}%20enquiry&amp;body=Hello%2C%20I%20would%20like%20to%20enquire%20about%20{{ mouldCategory.name | urlencode }}%3A%0A{{ canonical | urlencode }}%0A%0AChannel%3A%20website" data-mould-cta="category_floating_email" aria-label="E-mail Realjet about {{ mouldCategory.name }}" title="E-mail">
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
    <span class="category-action-label">Email</span>
  </a>
</nav>
