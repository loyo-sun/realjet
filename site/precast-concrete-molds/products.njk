---
pagination:
  data: precastMouldCatalog.products
  size: 1
  alias: mouldProduct
permalink: "/precast-concrete-molds/{{ mouldProduct.slug }}/index.html"
layout: layouts/base.njk
pageType: precast-mould-product
robots: index, follow
eleventyComputed:
  title: "{{ mouldProduct.title }}"
  seoTitle: "{{ mouldProduct.title }} for Precast Concrete | Realjet"
  description: "{{ mouldProduct.description }}"
  canonical: "https://realjetech.com/precast-concrete-molds/{{ mouldProduct.slug }}/"
  socialImage: "https://realjetech.com{{ precastMouldCatalog.placeholderImage }}"
---
{% set mouldCategory = precastMouldCatalog.categories | mouldCategoryBySlug(mouldProduct.category) %}
<article class="mould-product-page">
  <header class="mould-product-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/precast-concrete-molds/">Precast Concrete Moulds</a><span aria-hidden="true">/</span><a href="/precast-concrete-molds/{{ mouldCategory.slug }}/">{{ mouldCategory.name }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ mouldProduct.title }}</span></nav>
      <div class="mould-product-hero-grid">
        <div>
          <span class="eyebrow">{{ mouldCategory.name }}</span>
          <h1>{{ mouldProduct.title }}</h1>
          <p>{{ mouldProduct.description }}</p>
          <a class="button button-primary" href="/precast-concrete-molds/#mould-enquiry" data-mould-cta="product_enquiry">Request a Technical Review <span aria-hidden="true">→</span></a>
        </div>
        <figure>
          <img src="{{ precastMouldCatalog.placeholderImage }}" alt="{{ mouldProduct.imageAlt }}" width="1200" height="675" decoding="async" />
          <figcaption>Placeholder image — replace with product-specific photography when available.</figcaption>
        </figure>
      </div>
    </div>
  </header>
  <div class="container mould-product-content">
    <section aria-labelledby="application-title"><span class="eyebrow">Application</span><h2 id="application-title">Production scenarios and design basis</h2><p>{{ mouldProduct.application }}</p></section>
    <section aria-labelledby="performance-title"><span class="eyebrow">Performance</span><h2 id="performance-title">Engineering features</h2><ul>{% for feature in mouldProduct.performance %}<li>{{ feature }}</li>{% endfor %}</ul><p class="mould-boundary">Final component tolerances and acceptance criteria remain subject to the approved project documents, production controls and applicable standards.</p></section>
    <section aria-labelledby="inputs-title"><span class="eyebrow">Technical Review</span><h2 id="inputs-title">Required project inputs</h2><p>{{ mouldProduct.inputs }}</p></section>
    <section aria-labelledby="company-title"><span class="eyebrow">About Realjet</span><h2 id="company-title">Project-specific equipment delivery</h2><p>{{ precastMouldCatalog.companyIntroduction }}</p></section>
  </div>
</article>
