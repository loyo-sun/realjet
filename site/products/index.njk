---
pagination:
  data: collections.productCataloguePages
  size: 1
  alias: catalogue
layout: layouts/base.njk
permalink: "{{ catalogue.url }}index.html"
pageType: products
robots: index, follow
eleventyComputed:
  title: "{{ catalogue.seoTitle }}"
  seoTitle: "{{ catalogue.seoTitle }}"
  description: "{{ catalogue.description }}"
  canonical: "https://realjetech.com{{ catalogue.url }}"
---
<header class="listing-hero catalogue-hero">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span>
      {% if catalogue.category.slug != "all" %}<a href="/products/">Products</a><span aria-hidden="true">/</span>{% endif %}
      {% if catalogue.number > 1 %}<a href="{{ catalogue.category.url }}">{{ catalogue.heading }}</a><span aria-hidden="true">/</span><span aria-current="page">Page {{ catalogue.number }}</span>{% else %}<span aria-current="page">{{ catalogue.heading }}</span>{% endif %}
    </nav>
    <span class="eyebrow">Equipment &amp; Components</span>
    <h1>{{ catalogue.heading }}{% if catalogue.number > 1 %} <span class="catalogue-page-number">— Page {{ catalogue.number }}</span>{% endif %}</h1>
    <p>{{ catalogue.category.description or "Project-specific precast production equipment, steel moulds and drawing-based components for machinery manufacturers and equipment integrators." }}</p>
  </div>
</header>
<section class="product-listing-section catalogue-listing" aria-label="Product catalogue">
  <div class="container">
    <nav class="catalogue-categories" aria-label="Product categories">
      {% for category in catalogue.navigation %}
      <a href="{{ category.url }}"{% if category.slug == catalogue.category.slug %} class="is-current" aria-current="{% if catalogue.number == 1 %}page{% else %}true{% endif %}"{% endif %}><span>{{ category.name }}</span><span class="catalogue-category-count" aria-label="{{ category.count }} products">{{ category.count }}</span></a>
      {% endfor %}
    </nav>
    <div class="catalogue-toolbar">
      <p class="catalogue-result-count">Showing <strong>{{ catalogue.start }}–{{ catalogue.end }}</strong> of <strong>{{ catalogue.total }}</strong> products{% if catalogue.category.slug != "all" %} in {{ catalogue.category.name }}{% endif %}</p>
      {% if catalogue.category.series == "contract-manufacturing" %}<a href="/products/ai-infrastructure-components/">AI infrastructure components →</a><a href="/products/new-energy-components/">Battery storage, EV charging and solar components →</a>{% endif %}
      {% if catalogue.category.series == "precast-concrete-moulds" %}<a href="/precast-concrete-molds/">Explore moulds by application <span aria-hidden="true">→</span></a>{% endif %}
      {% if catalogue.category.series == "precast-wall-slab-equipment" %}<a href="/solutions/precast-concrete-plant/">Plan a wall and slab production line</a>{% endif %}
    </div>
    {% if catalogue.products.length %}
    <h2 class="sr-only">{{ catalogue.category.name }} catalogue</h2>
    <div class="product-grid catalogue-product-grid">
      {% for product in catalogue.products %}{% include "components/product-card.njk" %}{% endfor %}
    </div>
    {% else %}<div class="empty-insights"><h2>Products are being prepared.</h2><p>Contact Realjet to discuss your component or equipment requirements.</p></div>{% endif %}
    {% if catalogue.totalPages > 1 %}
    <nav class="pagination catalogue-pagination" aria-label="Product catalogue pages">
      {% if catalogue.previousUrl %}<a class="pagination-direction" href="{{ catalogue.previousUrl }}" rel="prev"><span aria-hidden="true">←</span> Previous</a>{% else %}<span class="pagination-direction is-disabled" aria-disabled="true"><span aria-hidden="true">←</span> Previous</span>{% endif %}
      <ol>{% for link in catalogue.pageLinks %}<li>{% if link.number == catalogue.number %}<span class="pagination-page is-current" aria-current="page"><span class="sr-only">Page </span>{{ link.number }}</span>{% else %}<a class="pagination-page" href="{{ link.url }}" aria-label="Page {{ link.number }}">{{ link.number }}</a>{% endif %}</li>{% endfor %}</ol>
      {% if catalogue.nextUrl %}<a class="pagination-direction" href="{{ catalogue.nextUrl }}" rel="next">Next <span aria-hidden="true">→</span></a>{% else %}<span class="pagination-direction is-disabled" aria-disabled="true">Next <span aria-hidden="true">→</span></span>{% endif %}
    </nav>
    {% endif %}
  </div>
</section>
{% include "components/business-promos.njk" %}
